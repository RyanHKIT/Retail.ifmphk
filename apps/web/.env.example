VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Set to 1 to show the AI analysis block and the platform Q&A panel.
# Everything else the AI features need (AI_BASE_URL, AI_MODEL, AI_API_KEY) is a
# Supabase Edge Function secret, set with:
#   supabase secrets set AI_BASE_URL=... AI_MODEL=... AI_API_KEY=...
#
# NEVER put the provider key here. Vite inlines every VITE_* variable into the
# public JS bundle, so a key placed in this file is published to every visitor.
VITE_AI_ENABLED=0
