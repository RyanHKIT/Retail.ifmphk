# Secrets for the AI edge functions (ai-insight, ai-ask).
#
# These are SERVER-SIDE only. Set them on the hosted project with:
#   npx supabase secrets set --project-ref <ref> AI_API_KEY=... AI_MODEL=...
# For local smoke testing, copy this file to supabase/.env.local and fill it in.
# supabase/.env.local is gitignored; this example file is not.
#
# Never put the key in apps/web/.env. Vite inlines every VITE_* variable into
# the public bundle, so a key placed there ships to every visitor.

AI_BASE_URL=https://toai.hk/v1
AI_MODEL=qwen3.7-flash-2026-07-15
AI_API_KEY=

# Skip the model's hidden reasoning. Default true.
#
# qwen3.7-flash is a reasoning model. On the insight prompt it spent 10,497
# characters of internal reasoning to write a 317 character answer, taking 50.7
# seconds. The function timeout is 30 seconds, so every analysis call would fail
# with this switched off. With it on: 3.0 seconds, 147 tokens, same output shape.
# Only set false if you also raise AI_TIMEOUT_MS, and expect slow answers.
# AI_DISABLE_THINKING=true

# Provider-specific reasoning hint, sent only when AI_DISABLE_THINKING is true.
# 'none' measured marginally faster than enable_thinking alone. Leave unset
# unless the provider documents a different value, since some providers reject
# the parameter outright.
# AI_REASONING_EFFORT=none

# Output budget per call. Reasoning is suppressed, so 700 is comfortable:
# a typical insight uses under 200.
# AI_MAX_TOKENS=700

# Per-call timeout. 30s is ample while reasoning is suppressed.
# AI_TIMEOUT_MS=30000
