# Dependencies
node_modules/

# Build output
dist/
.vite/

# Environment (never commit secrets)
.env
.env.*
!.env.example
# Edge function secrets for local `supabase functions serve`. Named explicitly
# so a future .gitignore rewrite cannot start committing a provider API key.
supabase/.env.local
supabase/functions/.env

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Logs & OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Wrangler local state, created by `wrangler pages dev` and `wrangler login`.
# Machine-specific and never needed for a deploy.
.wrangler/

# Editor
.idea/
.vscode/*
!.vscode/extensions.json

# Agent process artifacts (briefs, reports, review diffs). Not product code.
.superpowers/

# Extracted handoff dump and third-party reference codebases. Not product code.
_handoff_extract/
_reference/

# Generated render output for decks.
output/

# Python bytecode from the deck scripts.
__pycache__/
*.pyc

# Rendered slide PNGs and contact sheets used to review a deck before handing it
# over. Regenerated by scripts/deck, so the binaries stay out of history.
docs/presentation/_render/

# Template media unpacked for inspection during deck work.
docs/presentation/_tpl-media/

# The corporate template itself. It is the company's file, not ours.
docs/presentation/company-template.pptx
